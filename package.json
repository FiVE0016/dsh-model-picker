{
  "name": "dsh-model-picker",
  "version": "0.3.2",
  "description": "Native right-sidebar tab that lists every model the host currently advertises, grouped by provider, highlights the active one, and switches the session model on click.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "model",
    "sidebar",
    "picker"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "DEVELOPING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "FiVE0016"
}
